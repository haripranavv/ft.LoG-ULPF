# ==================================================
# ULPF - Environment Configuration
# Copy this file to .env and configure for production.
# ==================================================

# --------------------------------------------------
# Backend Authentication (CHANGE THESE)
# --------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=generate_a_random_secure_string_here
JWT_EXPIRATION_HOURS=24

# --------------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------------
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ulpf_secure_password
POSTGRES_DB=ulpf_db
DATABASE_URL=postgresql://ulpf:ulpf_secure_password@postgres:5432/ulpf_db

# --------------------------------------------------
# Frontend Configuration
# --------------------------------------------------
VITE_API_URL=/api
